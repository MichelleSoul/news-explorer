          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.token) {\r",
                  "    pm.collectionVariables.set(\"jwt_token\", response.token);\r",
                  "    console.log(\"JWT token updated in collection variables\");\r",
                  "} else {\r",
                  "    console.warn(\"No token found in response\");\r",
